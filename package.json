{
  "name": "vscode-kubernetes-tools-api",
  "version": "1.3.0",
  "description": "Documents and encapsulates the API for the Kubernetes extension for Visual Studio Code",
  "main": "js/index.js",
  "types": "js/index.d.ts",
  "files": [
    "js/**/*"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepare": "npx @vscode/dts dev && npm run compile",
    "lint": "eslint ts/**/*.ts",
    "lint:fix": "eslint ts/**/*.ts --fix",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Azure/vscode-kubernetes-tools-api"
  },
  "keywords": [
    "Kubernetes"
  ],
  "author": "itowlson@microsoft.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Azure/vscode-kubernetes-tools-api/issues"
  },
  "homepage": "https://github.com/Azure/vscode-kubernetes-tools-api#readme",
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/dts": "^0.4.0",
    "eslint": "^8.0.0",
    "mocha": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
